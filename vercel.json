{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com https://www.bllmarcenaria.com https://www.mabllar.com; frame-src https://www.google.com; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "mabllar.com"
        }
      ],
      "dest": "/sitemap-mabllar.xml"
    },
    {
      "src": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "www.mabllar.com"
        }
      ],
      "dest": "/sitemap-mabllar.xml"
    },
    {
      "src": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "mabllar.com"
        }
      ],
      "dest": "/robots-mabllar.txt"
    },
    {
      "src": "/favicon.ico",
      "has": [
        {
          "type": "host",
          "value": "mabllar.com"
        }
      ],
      "dest": "/assets/brand/mab-llar-favicon-64.png"
    },
    {
      "src": "/favicon.ico",
      "has": [
        {
          "type": "host",
          "value": "www.mabllar.com"
        }
      ],
      "dest": "/assets/brand/mab-llar-favicon-64.png"
    },
    {
      "src": "/favicon.ico",
      "dest": "/assets/brand/favicon-64.png"
    },
    {
      "src": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "www.mabllar.com"
        }
      ],
      "dest": "/robots-mabllar.txt"
    },
    {
      "src": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "mabllar.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "www.mabllar.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/galeria.html",
      "has": [
        {
          "type": "host",
          "value": "mabllar.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/galeria.html",
      "has": [
        {
          "type": "host",
          "value": "www.mabllar.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/loja.html",
      "has": [
        {
          "type": "host",
          "value": "mabllar.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/loja.html",
      "has": [
        {
          "type": "host",
          "value": "www.mabllar.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "mabllar.com"
        }
      ],
      "dest": "/loja.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mabllar.com"
        }
      ],
      "dest": "/loja.html"
    },
    {
      "src": "/loja",
      "dest": "/loja.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
