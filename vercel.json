{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mabllar.com"
        }
      ],
      "destination": "/loja",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mabllar.com"
        }
      ],
      "destination": "/loja",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mabllar.com"
        }
      ],
      "destination": "/loja.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mabllar.com"
        }
      ],
      "destination": "/loja.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/loja",
      "destination": "/loja.html"
    }
  ]
}
