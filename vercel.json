{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "mabllar.com"
        }
      ],
      "dest": "/sitemap-mabllar.xml"
    },
    {
      "src": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "www.mabllar.com"
        }
      ],
      "dest": "/sitemap-mabllar.xml"
    },
    {
      "src": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "mabllar.com"
        }
      ],
      "dest": "/robots-mabllar.txt"
    },
    {
      "src": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "www.mabllar.com"
        }
      ],
      "dest": "/robots-mabllar.txt"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "mabllar.com"
        }
      ],
      "dest": "/loja.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mabllar.com"
        }
      ],
      "dest": "/loja.html"
    },
    {
      "src": "/loja",
      "dest": "/loja.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
